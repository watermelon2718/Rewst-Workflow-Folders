{
  "manifest_version": 3,
  "name": "Rewst Workflow Folders",
  "version": "1.1.0",
  "description": "Adds folder organisation to the Rewst workflows list",
  "permissions": ["storage", "tabs", "downloads"],
  "host_permissions": [
    "https://app.rewst.asia/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rewst-workflow-folders@yourdomain.example",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rewst Workflow Folders"
  },
  "content_scripts": [
    {
      "matches": ["https://app.rewst.asia/organizations/*/workflows*"],
      "js": ["storage.js", "rows.js", "contextmenu.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}